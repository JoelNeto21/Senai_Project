    {
      "name": "Authentication",
      "item": [
        {
          "name": "Login with Valid Credentials",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 or 302\", function() {\n    pm.expect([200, 302]).to.include(pm.response.code);\n});\n\npm.test(\"Set-Cookie header exists\", function() {\n    pm.expect(pm.response.headers.get('Set-Cookie')).to.exist;\n});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"password\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/login",
              "host": ["{{base_url}}"],
              "path": ["login"]
            },
            "description": "Login with valid email and password\nExpected: 200 or 302 redirect\nCookie should be set in response"
          }
        },
